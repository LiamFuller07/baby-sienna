# Client material never enters git: real engagements and the earlier client pages.
/work/
/reference/

# Raw input formats anywhere outside the placeholder example.
*.xlsx
*.xls
*.xlsm
*.ods
*.csv
*.tsv
*.docx
*.doc
*.pptx
*.pdf
*.vtt
*.srt
*.eml
*.msg
*.mbox
*.zip
!/examples/inputs/**

# Built pages: every one is generated, so only its sources are committed.
out/
# A document's copy without its mode line, which bs.py build writes beside it and removes.
.*.bs-build.md
/design-system/*/specimen.html
/design-system/document/example-a4.html
/design-system/document/example-screen.html

# Design references from other firms and clients, wherever they are saved.
*reference*.html

# Python and OS noise
__pycache__/
*.pyc
.DS_Store

# Local tool state (uv, ruff)
.venv/
.ruff_cache/
